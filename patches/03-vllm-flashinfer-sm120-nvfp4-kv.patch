+    if _is_nvfp4_cache_dtype(dtype_k):
+        (k_cache,), (k_sf,) = nvfp4_kv_cache_split_views(k_cache)
+    if _is_nvfp4_cache_dtype(dtype_v):
+        (v_cache,), (v_sf,) = nvfp4_kv_cache_split_views(v_cache)
