+@triton.jit
+def _nvfp4_v_sf_fill_kernel(
+    slot_mapping_ptr,  # int[T]
+    v_src_ptr,  # uint8, interleaved-cache V-SF view (4-token swizzled), SRC strides
+    v_dst_ptr,  # uint8, persistent CONTIGUOUS de-swizzled V-SF cache, DST strides
+    v_src_off_ptr,  # int32[PAGE_SIZE*SD], within-(block,head) de-swizzle src offsets (SRC strides)
+    src_blk_stride,  # v_sf.stride(0)
+    src_head_stride,  # v_sf head stride
+    dst_blk_stride,  # v_dst.stride(0)  (contiguous)
+    dst_tok_stride,  # v_dst token (page-dim) stride (contiguous)
+    dst_head_stride,  # v_dst head stride (contiguous)
+    PAGE_SIZE: tl.constexpr,
+    SD: tl.constexpr,
+    H_KV: tl.constexpr,
+):
+    """Incrementally de-swizzle the just-written V block-scales into the persistent
+    CONTIGUOUS V-SF cache (one program per slot). K needs NO cache: the explicit-
+    SF-stride fa2 kernel reads K straight from the interleaved view. Fully stride-
+    driven (correct for NHD and HND), graph-capturable: grid=(T,) constant for a
+    captured batch size, invalid (-1 padded) slots masked, no host sync.
+    O(new tokens) instead of O(referenced context)."""
+    i = tl.program_id(0)
+    s = tl.load(slot_mapping_ptr + i)
+    valid = s >= 0
+    s_safe = tl.where(valid, s, 0)
+    page = s_safe // PAGE_SIZE
+    tok = s_safe % PAGE_SIZE
+    offs_d = tl.arange(0, SD)
+    # de-swizzled linear destination within (block,head) (contiguous: sd stride == 1)
+    dst_region = tok * dst_tok_stride + offs_d
+    # swizzled source offset within (block,head) (table built with the SRC token stride)
+    v_src_region = tl.load(v_src_off_ptr + tok * SD + offs_d)
+    for h in tl.static_range(H_KV):
+        src_base = page * src_blk_stride + h * src_head_stride
+        dst_base = page * dst_blk_stride + h * dst_head_stride
+        v_val = tl.load(v_src_ptr + src_base + v_src_region, mask=valid, other=0)
+        tl.store(v_dst_ptr + dst_base + dst_region, v_val, mask=valid)
+
