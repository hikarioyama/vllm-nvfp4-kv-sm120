+# Shared V-only de-swizzle scratch for the SM120 fa2 NVFP4 *fallback* path (before the
+# first cache update / for KV-sharing layers, where the persistent V cache is absent).
+# K needs no scratch — the explicit-SF-stride kernel reads it directly from the
+# interleaved view. Keyed by V SF shape; reused across layers (sequential, one stream).
+_NVFP4_SF_SCRATCH: dict = {}
+
+
+def _get_nvfp4_v_sf_scratch(v_sf: torch.Tensor) -> torch.Tensor:
+    """Allocate/reuse a CONTIGUOUS de-swizzled V SF scratch (real size, no 2.25x
+    over-alloc). With explicit SF strides the fa2 kernel reads V using this tensor's
+    own contiguous strides, and K straight from the interleaved cache view (zero-copy).
+    """
+    key = (v_sf.device.index, tuple(v_sf.shape))
+    sc = _NVFP4_SF_SCRATCH.get(key)
+    if sc is None:
+        sc = torch.empty(tuple(v_sf.shape), dtype=v_sf.dtype, device=v_sf.device)
+        _NVFP4_SF_SCRATCH[key] = sc
+    return sc
+
