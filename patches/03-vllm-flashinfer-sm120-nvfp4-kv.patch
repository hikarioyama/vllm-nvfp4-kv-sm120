+def _use_fa2_for_nvfp4_kv_on_sm120() -> bool:
+    """SM120 lacks trtllm-gen NVFP4 KV cubins; use FlashInfer FA2 instead."""
+    if not torch.cuda.is_available():
+        return False
+    major, minor = torch.cuda.get_device_capability()
+    return major == 12 and minor in (0, 1)
+
+
+# Shared V-only de-swizzle scratch for the SM120 fa2 NVFP4 *fallback* path (before the
+# first cache update / for KV-sharing layers, where the persistent V cache is absent).
+# K needs no scratch — the explicit-SF-stride kernel reads it directly from the
+# interleaved view. Keyed by V SF shape; reused across layers (sequential, one stream).
+_NVFP4_SF_SCRATCH: dict = {}
+
+
+def _get_nvfp4_v_sf_scratch(v_sf: torch.Tensor) -> torch.Tensor:
+    """Allocate/reuse a CONTIGUOUS de-swizzled V SF scratch (real size, no 2.25x
+    over-alloc). With explicit SF strides the fa2 kernel reads V using this tensor's
+    own contiguous strides, and K straight from the interleaved cache view (zero-copy).
+    """
+    key = (v_sf.device.index, tuple(v_sf.shape))
+    sc = _NVFP4_SF_SCRATCH.get(key)
+    if sc is None:
+        sc = torch.empty(tuple(v_sf.shape), dtype=v_sf.dtype, device=v_sf.device)
+        _NVFP4_SF_SCRATCH[key] = sc
+    return sc
+
+
+def _trtllm_v_scale_to_linear_for_fa2(
+    v_scale: torch.Tensor, kv_layout: str
+) -> torch.Tensor:
+    """Undo TRT-LLM's 4-token V-scale swizzle before calling FA2."""
+    scale_dim = v_scale.shape[-1]
+    if kv_layout == "NHD":
+        num_pages, page_size, num_kv_heads, _ = v_scale.shape
+        swizzled_shape = (
+            num_pages,
+            page_size // 4,
+            4,
+            num_kv_heads,
+            scale_dim // 4,
+            4,
+        )
+        inverse_perm = (0, 1, 5, 3, 2, 4)
+        out_shape = (num_pages, page_size, num_kv_heads, scale_dim)
+    else:
+        num_pages, num_kv_heads, page_size, _ = v_scale.shape
+        swizzled_shape = (
+            num_pages,
+            num_kv_heads,
+            page_size // 4,
+            4,
+            scale_dim // 4,
+            4,
+        )
+        inverse_perm = (0, 1, 2, 5, 3, 4)
+        out_shape = (num_pages, num_kv_heads, page_size, scale_dim)
+
+    return v_scale.reshape(swizzled_shape).permute(inverse_perm).reshape(out_shape)
+
+
+def _build_v_deswz_src_offsets(
+    layout: str,
+    page_size: int,
+    scale_dim: int,
+    tok_stride: int,
+    device: torch.device,
+) -> torch.Tensor:
+    """Per-(token, scale-dim) WITHIN-(block,head) source offset that de-swizzles
+    the writer's 4-token-interleaved V block-scales into linear order, EXACTLY
+    matching ``_trtllm_v_scale_to_linear_for_fa2`` for the given layout.
+
+    The 4-token x 4-subblock swizzle only mixes (token, d) within a (block,head)
+    and is identical for NHD and HND; only the tensor dim order (hence the token
+    stride) differs. We build the map by running the SAME inverse permutation on a
+    tensor whose value at swizzled-storage (t', d') is its own within-region
+    offset ``t'*tok_stride + d'``; the de-swizzled result at (tok, d) is then the
+    source offset to gather from. Returned flat as ``[token*scale_dim + d]``.
+    """
+    p, sd = page_size, scale_dim
+    toks = torch.arange(p, device=device, dtype=torch.int32)
+    ds = torch.arange(sd, device=device, dtype=torch.int32)
+    if layout == "NHD":
+        store = (toks.view(1, p, 1, 1) * tok_stride + ds.view(1, 1, 1, sd)).expand(
+            1, p, 1, sd
+        ).contiguous()
+        desw = _trtllm_v_scale_to_linear_for_fa2(store, "NHD")  # (1,p,1,sd)
+        off = desw[0, :, 0, :]
+    else:  # HND
+        store = (toks.view(1, 1, p, 1) * tok_stride + ds.view(1, 1, 1, sd)).expand(
+            1, 1, p, sd
+        ).contiguous()
+        desw = _trtllm_v_scale_to_linear_for_fa2(store, "HND")  # (1,1,p,sd)
+        off = desw[0, 0, :, :]
+    return off.reshape(-1).to(torch.int32).contiguous()  # [page_size*scale_dim]
+
